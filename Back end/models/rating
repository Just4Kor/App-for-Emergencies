from datetime import datetime

from models.person import ValidationError


class WorkerRating:
    def __init__(
        self,
        rating_id,
        customer_id,
        worker_id,
        score,
        comment,
        created_at
    ):
        self._rating_id = rating_id
        self.customer_id = customer_id
        self.worker_id = worker_id
        self.score = score
        self.comment = comment
        self._created_at = created_at or datetime.utcnow().isoformat()

    @property
    def rating_id(self):
        return self._rating_id

    @property
    def customer_id(self):
        return self._customer_id

    @customer_id.setter
    def customer_id(self, value):
        if value <= 0:
            raise ValidationError("Customer ID must be greater than 0.")
        self._customer_id = value

    @property
    def worker_id(self):
        return self._worker_id

    @worker_id.setter
    def worker_id(self, value):
        if value <= 0:
            raise ValidationError("Worker ID must be greater than 0.")
        self._worker_id = value

    @property
    def score(self):
        return self._score

    @score.setter
    def score(self, value):
        if not isinstance(value, int):
            raise ValidationError("Rating score must be an integer.")
        if value < 1 or value > 5:
            raise ValidationError("Rating score must be between 1 and 5.")
        self._score = value

    @property
    def comment(self):
        return self._comment

    @comment.setter
    def comment(self, value):
        self._comment = value.strip()

    @property
    def created_at(self)r:
        return self._created_at

    def update_rating(self, score, comment):
        self.score = score
        self.comment = comment
        self._created_at = datetime.utcnow().isoformat()

    def to_dict(self):
        return {
            "rating_id": self.rating_id,
            "customer_id": self.customer_id,
            "worker_id": self.worker_id,
            "score": self.score,
            "comment": self.comment,
            "created_at": self.created_at,
        }
