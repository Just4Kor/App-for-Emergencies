from datetime import datetime


class ServiceRequest:
    def __init__(
        self,
        request_id,
        problem_title,
        problem_description,
        worker_name,
        worker_specialty,
        worker_location,
        hourly_rate,
        rating,
        created_at
    ):
        self._request_id = request_id
        self.problem_title = problem_title
        self.problem_description = problem_description
        self.worker_name = worker_name
        self.worker_specialty = worker_specialty
        self.worker_location = worker_location
        self.hourly_rate = hourly_rate
        self.rating = rating
        self._created_at = created_at or datetime.utcnow().isoformat()

    @property
    def request_id(self):
        return self._request_id

    @property
    def created_at(self):
        return self._created_at

    def to_dict(self):
        return {
            "request_id": self.request_id,
            "problem_title": self.problem_title,
            "problem_description": self.problem_description,
            "worker_name": self.worker_name,
            "worker_specialty": self.worker_specialty,
            "worker_location": self.worker_location,
            "hourly_rate": self.hourly_rate,
            "rating": self.rating,
            "created_at": self.created_at,
        }
