class SearchEngine:
    def filter_workers(
        self,
        workers,
        location,
        specialty
    ):
        filtered_workers = workers

        if location:
            filtered_workers = [
                worker
                for worker in filtered_workers
                if worker.location.lower() == location.lower()
            ]

        if specialty:
            filtered_workers = [
                worker
                for worker in filtered_workers
                if worker.specialty.lower() == specialty.lower()
            ]

        return filtered_workers

    def sort_workers(self, workers):
        return sorted(workers, key=lambda worker: (-worker.rating, worker.rate))
