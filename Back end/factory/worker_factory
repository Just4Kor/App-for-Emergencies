from models.worker import Worker


class WorkerFactory:
    @staticmethod
    def create(
        specialty,
        person_id,
        name,
        location,
        rate,
        rating
    ):
        return Worker(
            person_id=person_id,
            name=name,
            location=location,
            rate=rate,
            rating=rating,
            specialty=specialty.strip().title(),
        )
