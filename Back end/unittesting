import unittest

from models.user import User
from models.worker import Worker
from models.request import ServiceRequest
from models.rating import WorkerRating
from services.platform import Platform


class TestUser(unittest.TestCase):

    def test_create_user(self):
        user = User(1, "Alisa", "Vilnius", "Vilnius")

        self.assertEqual(user.name, "Alisa")
        self.assertEqual(user.city, "Vilnius")

    def test_add_request_limit(self):
        user = User(1, "Alisa", "Vilnius", "Vilnius")
        worker = Worker(1, "Rokas", "Vilnius", "Plumber", 20)

        for i in range(6):
            req = ServiceRequest(i, user, worker, "Fix", "Leak")
            user.add_request(req)

        self.assertEqual(len(user.requests), 5)


class TestWorker(unittest.TestCase):

    def test_worker_creation(self):
        worker = Worker(1, "Bob", "Kaunas", "Mechanic", 25)

        self.assertEqual(worker.specialty, "Mechanic")
        self.assertEqual(worker.rate, 25)

    def test_invalid_rate(self):
        with self.assertRaises(ValueError):
            Worker(1, "Rokas", "Kaunas", "Mechanic", -5)

    def test_invalid_rating(self):
        worker = Worker(1, "Rokas", "Kaunas", "Mechanic", 25)

        with self.assertRaises(ValueError):
            worker.update_rating(6)


class TestRequest(unittest.TestCase):

    def test_request_status(self):
        user = User(1, "Alisa", "Vilnius", "Vilnius")
        worker = Worker(1, "Rokas", "Vilnius", "Plumber", 20)

        req = ServiceRequest(1, user, worker, "Fix", "Leak")

        req.accept()
        self.assertEqual(req.status, "Accepted")

        req.deny()
        self.assertEqual(req.status, "Denied")


class TestRating(unittest.TestCase):

    def test_rating_creation(self):
        user = User(1, "Alisa", "Vilnius", "Vilnius")
        worker = Worker(1, "Rokas", "Vilnius", "Plumber", 20)

        rating = WorkerRating(user, worker, 5, "Great")

        self.assertEqual(rating.score, 5)

    def test_invalid_rating(self):
        user = User(1, "Alisa", "Vilnius", "Vilnius")
        worker = Worker(1, "Rokas", "Vilnius", "Plumber", 20)

        with self.assertRaises(ValueError):
            WorkerRating(user, worker, 6)


class TestPlatform(unittest.TestCase):

    def test_add_worker(self):
        platform = Platform()
        worker = Worker(1, "Rokas", "Vilnius", "Plumber", 20)

        platform.add_worker(worker)

        self.assertEqual(len(platform.workers), 1)

    def test_create_request(self):
        platform = Platform()
        user = User(1, "Alisa", "Vilnius", "Vilnius")
        worker = Worker(1, "Rokas", "Vilnius", "Plumber", 20)

        platform.add_user(user)
        platform.add_worker(worker)

        req = platform.create_request(user, worker, "Fix", "Leak")

        self.assertEqual(req.title, "Fix")
        self.assertEqual(len(platform.requests), 1)


if __name__ == "__main__":
    unittest.main()
