import unittest

from factory.account_factory import AccountFactory
from models.request import ServiceRequest
from models.request_status import RequestStatus
from models.worker import Worker
from services.search import SearchEngine


class TestWorker(unittest.TestCase):
    def test_worker_creation(self):
        worker = Worker(
            worker_id="1",
            username="Jonas",
            password="123",
            specialty="Plumber",
            location="Vilnius",
            hourly_rate="20",
            rating="4.5",
        )

        self.assertEqual(worker.username, "Jonas")
        self.assertEqual(worker.specialty, "Plumber")
        self.assertEqual(worker.location, "Vilnius")

    def test_worker_rating(self):
        worker = Worker(
            worker_id="1",
            username="Jonas",
            password="123",
            specialty="Plumber",
            location="Vilnius",
            hourly_rate="20",
            rating="4.5",
        )

        self.assertEqual(worker.get_rating(), 4.5)


class TestRequest(unittest.TestCase):
    def test_accept_request(self):
        request = ServiceRequest(
            request_id="1",
            title="Leak",
            description="Sink is leaking",
            address="Street 1",
            status=RequestStatus.PENDING,
            customer_id="100",
            worker_id="1",
        )

        request.accept()

        self.assertEqual(request.status, RequestStatus.ACCEPTED)

    def test_deny_request(self):
        request = ServiceRequest(
            request_id="1",
            title="Leak",
            description="Sink is leaking",
            address="Street 1",
            status=RequestStatus.PENDING,
            customer_id="100",
            worker_id="1",
        )

        request.deny()

        self.assertEqual(request.status, RequestStatus.DENIED)


class TestFactory(unittest.TestCase):
    def test_create_customer(self):
        customer = AccountFactory.create_customer(
            user_id="100",
            username="Alisa",
            password="123",
            city="Vilnius",
        )

        self.assertEqual(customer.role, "customer")
        self.assertEqual(customer.city, "Vilnius")

    def test_create_worker(self):
        worker = AccountFactory.create_worker(
            worker_id="1",
            username="Rokas",
            password="123",
            specialty="Electrician",
            location="Kaunas",
            hourly_rate="25",
        )

        self.assertEqual(worker.role, "worker")
        self.assertEqual(worker.specialty, "Electrician")


class TestSearch(unittest.TestCase):
    def test_filter_by_location(self):
        workers = [
            Worker("1", "Jonas", "123", "Plumber", "Vilnius", "20", "4.5"),
            Worker("2", "Rokas", "123", "Electrician", "Kaunas", "25", "4.8"),
        ]

        search = SearchEngine()
        result = search.filter_workers(workers, location="Vilnius")

        self.assertEqual(len(result), 1)
        self.assertEqual(result[0].username, "Jonas")


if __name__ == "__main__":
    unittest.main()
