class TestWorkerFactory(unittest.TestCase):
    def test_create_plumber(self):
        worker = WorkerFactory.create("Plumber", 1, "John", "Vilnius", 20, 4.5)
        self.assertEqual(worker.specialty, "Plumber")
        self.assertEqual(worker.name, "John")

    def test_create_new_specialty(self):
        worker = WorkerFactory.create("Carpenter", 2, "Mark", "Kaunas", 30, 4.4)
        self.assertEqual(worker.specialty, "Carpenter")

    def test_invalid_rate_raises_error(self):
        with self.assertRaises(ValidationError):
            WorkerFactory.create("Painter", 3, "Tom", "Vilnius", 0, 4.0)


class TestSearchEngine(unittest.TestCase):
    def setUp(self):
        self.search_engine = SearchEngine()
        self.w1 = WorkerFactory.create("Plumber", 1, "John", "Vilnius", 20, 4.5)
        self.w2 = WorkerFactory.create("Mechanic", 2, "Mike", "Kaunas", 25, 4.9)
        self.w3 = WorkerFactory.create("Electrician", 3, "Anna", "Vilnius", 22, 4.9)
        self.w4 = WorkerFactory.create("Carpenter", 4, "Mark", "Vilnius", 19, 4.3)
        self.workers = [self.w1, self.w2, self.w3, self.w4]

    def test_filter_workers_by_location(self):
        result = self.search_engine.filter_workers(self.workers, location="Vilnius")
        self.assertEqual(len(result), 3)

    def test_filter_workers_by_specialty(self):
        result = self.search_engine.filter_workers(self.workers, specialty="Carpenter")
        self.assertEqual(len(result), 1)
        self.assertEqual(result[0].name, "Mark")

    def test_sort_workers(self):
        result = self.search_engine.sort_workers(self.workers)
        self.assertEqual(result[0].name, "Anna")
        self.assertEqual(result[1].name, "Mike")


class TestPlatform(unittest.TestCase):
