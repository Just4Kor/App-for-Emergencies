class TestRatingService(unittest.TestCase):
    def setUp(self):
        self.service = RatingService()

    def test_add_rating(self):
        rating = WorkerRating(1, 1, 10, 5, "Excellent")
        self.service.add_rating(rating)
        self.assertEqual(len(self.service.ratings), 1)

    def test_update_existing_rating(self):
        rating_1 = WorkerRating(1, 1, 10, 4, "Good")
        rating_2 = WorkerRating(2, 1, 10, 5, "Excellent")

        self.service.add_rating(rating_1)
        self.service.add_rating(rating_2)

        self.assertEqual(len(self.service.ratings), 1)
        self.assertEqual(self.service.ratings[0].score, 5)

    def test_average_rating(self):
        self.service.add_rating(WorkerRating(1, 1, 10, 4, "Good"))
        self.service.add_rating(WorkerRating(2, 2, 10, 5, "Excellent"))
        self.assertEqual(self.service.get_average_rating(10), 4.5)


class TestJsonStorage(unittest.TestCase):
    def setUp(self):
        self.temp_file = tempfile.NamedTemporaryFile(delete=False)
        self.temp_file.close()
        self.storage = JsonStorage(self.temp_file.name)

    def tearDown(self):
        if os.path.exists(self.temp_file.name):
            os.remove(self.temp_file.name)

    def test_save_and_load_data(self):
        data = {
            "workers": [
                {
                    "name": "John",
                    "location": "Vilnius",
                    "rate": 20,
                    "rating": 4.5,
                    "specialty": "Plumber",
                }
            ]
        }
        self.storage.save(data)
        loaded_data = self.storage.load()
        self.assertEqual(data, loaded_data)

    def test_saved_file_contains_valid_json(self):
        data = {"workers": [{"name": "Anna"}]}
        self.storage.save(data)

        with open(self.temp_file.name, "r", encoding="utf-8") as file:
            parsed = json.load(file)

        self.assertEqual(parsed["workers"][0]["name"], "Anna")


