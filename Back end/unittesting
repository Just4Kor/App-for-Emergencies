        self.platform = Platform()
        self.w1 = WorkerFactory.create("Plumber", 1, "John", "Vilnius", 20, 4.5)
        self.w2 = WorkerFactory.create("Mechanic", 2, "Mike", "Kaunas", 25, 4.9)
        self.w3 = WorkerFactory.create("Carpenter", 3, "Mark", "Vilnius", 19, 4.4)

        self.platform.add_worker(self.w1)
