class TestUserModel(unittest.TestCase):
    def setUp(self):
        self.user = User(1, "Alice", "Vilnius", "Vilnius")

    def test_user_creation(self):
        self.assertEqual(self.user.person_id, 1)
        self.assertEqual(self.user.name, "Alice")
        self.assertEqual(self.user.location, "Vilnius")
        self.assertEqual(self.user.city, "Vilnius")

    def test_invalid_city_raises_error(self):
        with self.assertRaises(ValidationError):
            User(2, "Bob", "Kaunas", "")


